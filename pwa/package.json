{
  "name": "war-analyzer-pwa",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.9",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "generate:contracts": "python3 ../../war_game_engine/scripts/export_contract_schema.py && json2ts -i ../../war_game_engine/src/war_game_engine/schemas/contract-envelope-v1.json -o src/contracts.generated.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
